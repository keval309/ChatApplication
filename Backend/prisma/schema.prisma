// Prisma schema for streamChat auth flow (v1)
// Aligns with PRD §15 (User, Conversation, ...) and PRD §3 (Authentication)
// Conventions (per .cursor/rules/chatflow.mdc):
//   - cuid() ids
//   - createdAt / updatedAt on every model
//   - soft delete via deletedAt where applicable
//   - snake_case table names via @@map

generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum PresenceStatus {
  ONLINE
  AWAY
  DND
  INVISIBLE
  OFFLINE
}

enum NotificationLevel {
  ALL_MESSAGES
  MENTIONS_AND_REPLIES
  NOTHING
}

enum AuthProvider {
  GOOGLE
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ConversationType {
  DM
  GROUP
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  GIF
  FILE
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  username                String?           @unique
  displayName             String?
  passwordHash            String?
  avatarUrl               String?
  statusMessage           String?
  bio                     String?
  presenceStatus          PresenceStatus    @default(OFFLINE)
  lastSeenAt              DateTime?
  lastSeenVisible         Boolean           @default(true)
  sendReadReceipts        Boolean           @default(true)
  globalNotificationLevel NotificationLevel @default(ALL_MESSAGES)
  lastPresenceHeartbeatAt DateTime?
  autoUnmuteReminder      Boolean           @default(false)
  emailVerifiedAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts                Account[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  notificationPreferences ConversationNotificationPreference[]
  blockedUsers            Block[]                              @relation("user_blocks")
  blockedByUsers          Block[]                              @relation("user_blocked_by")
  conversationMembers     ConversationMember[]
  sentMessages            Message[]                            @relation("user_sent_messages")
  reactions               Reaction[]
  readReceipts            ReadReceipt[]

  @@index([email])
  @@index([username])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Account — OAuth provider link (PRD §3.1 account linking)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Session — refresh-token-backed session for concurrent session management
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  rememberMe       Boolean   @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// VerificationToken — email verification + password reset
// ─────────────────────────────────────────────────────────────────────────────

model VerificationToken {
  id         String                @id @default(cuid())
  userId     String
  tokenHash  String                @unique
  type       VerificationTokenType
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// LoginAttempt — used to enforce 5-fail / 15-min lockout (PRD §3.3)
// ─────────────────────────────────────────────────────────────────────────────

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocker User @relation("user_blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("user_blocked_by", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model ConversationNotificationPreference {
  id                 String            @id @default(cuid())
  userId             String
  conversationId     String
  notificationLevel  NotificationLevel @default(ALL_MESSAGES)
  isMuted            Boolean           @default(false)
  muteUntil          DateTime?
  autoUnmuteReminder Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([muteUntil])
  @@map("conversation_notification_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat — Conversation, Message, Reaction, ReadReceipt, MediaAttachment, GroupInfo
// (Per streamChat-socket-chat.md Part 2 + ChatFlow PRD §15)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id         String           @id @default(cuid())
  type       ConversationType
  /// userIds who archived this conversation for themselves
  archivedBy String[]         @default([])
  /// JSON map of userId → unmuteAt ISO string (null/missing = not muted)
  mutedBy    Json             @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   ConversationMember[]
  messages  Message[]
  groupInfo GroupInfo?

  @@map("conversations")
}

model ConversationMember {
  id             String                 @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now())
  lastReadAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String      @db.Text
  type           MessageType @default(TEXT)
  /// Self-relation for thread replies; null = top-level
  parentId       String?
  editedAt       DateTime?
  /// Soft delete — messages are never hard-deleted
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("user_sent_messages", fields: [senderId], references: [id])
  parent       Message?          @relation("MessageThread", fields: [parentId], references: [id])
  replies      Message[]         @relation("MessageThread")
  reactions    Reaction[]
  readReceipts ReadReceipt[]
  attachments  MediaAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([parentId])
  @@map("messages")
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One reaction per user per message — selecting a new emoji REPLACES the old.
  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("reactions")
}

model ReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  seenAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("read_receipts")
}

model MediaAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  blurhash  String?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("media_attachments")
}

model GroupInfo {
  id              String  @id @default(cuid())
  conversationId  String  @unique
  name            String
  description     String?
  avatarUrl       String?
  ownerId         String
  slowModeSeconds Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("group_info")
}
