// Prisma schema for streamChat auth flow (v1)
// Aligns with PRD §15 (User, Conversation, ...) and PRD §3 (Authentication)
// Conventions (per .cursor/rules/chatflow.mdc):
//   - cuid() ids
//   - createdAt / updatedAt on every model
//   - soft delete via deletedAt where applicable
//   - snake_case table names via @@map

generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum PresenceStatus {
  ONLINE
  AWAY
  DND
  INVISIBLE
  OFFLINE
}

enum NotificationLevel {
  ALL_MESSAGES
  MENTIONS_AND_REPLIES
  NOTHING
}

enum AuthProvider {
  GOOGLE
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  username        String?        @unique
  displayName     String?
  passwordHash    String?
  avatarUrl       String?
  statusMessage   String?
  bio             String?
  presenceStatus  PresenceStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  lastSeenVisible Boolean        @default(true)
  sendReadReceipts Boolean       @default(true)
  globalNotificationLevel NotificationLevel @default(ALL_MESSAGES)
  lastPresenceHeartbeatAt DateTime?
  autoUnmuteReminder Boolean     @default(false)
  emailVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts           Account[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  notificationPreferences ConversationNotificationPreference[]
  blockedUsers       Block[]        @relation("user_blocks")
  blockedByUsers     Block[]        @relation("user_blocked_by")

  @@index([email])
  @@index([username])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Account — OAuth provider link (PRD §3.1 account linking)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Session — refresh-token-backed session for concurrent session management
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  rememberMe       Boolean   @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// VerificationToken — email verification + password reset
// ─────────────────────────────────────────────────────────────────────────────

model VerificationToken {
  id          String                @id @default(cuid())
  userId      String
  tokenHash   String                @unique
  type        VerificationTokenType
  expiresAt   DateTime
  consumedAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// LoginAttempt — used to enforce 5-fail / 15-min lockout (PRD §3.3)
// ─────────────────────────────────────────────────────────────────────────────

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocker User @relation("user_blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("user_blocked_by", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model ConversationNotificationPreference {
  id                 String            @id @default(cuid())
  userId             String
  conversationId     String
  notificationLevel  NotificationLevel @default(ALL_MESSAGES)
  isMuted            Boolean           @default(false)
  muteUntil          DateTime?
  autoUnmuteReminder Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([muteUntil])
  @@map("conversation_notification_preferences")
}
