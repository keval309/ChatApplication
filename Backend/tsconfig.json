{
  "compilerOptions": {
    "target": "ES6",
    "types": ["node"],
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./app",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app"],
  "exclude": ["node_modules"]
}
