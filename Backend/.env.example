# ─────────────────────────────────────────────────────────────────────────────
# streamChat — Backend environment
# Copy this file to .env and fill in real values.
# Never commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=8080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streamchat?schema=public

# JWT — separate secrets for access and refresh
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-32-byte-random-string
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Public URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Email-token signing secrets (used internally; rotate to invalidate links)
EMAIL_TOKEN_SECRET=replace-with-random-string
PASSWORD_RESET_SECRET=replace-with-random-string

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="streamChat <no-reply@streamchat.local>"

# Rate limiting (in-memory in v1; swap to Redis later)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_HR=1
